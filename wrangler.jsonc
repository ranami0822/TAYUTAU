{
  // Cloudflare Workers static-asset deployment of the Vite build (docs/design-memo.md 7).
  // Deploy: npm run deploy   (needs CLOUDFLARE_API_TOKEN; CLOUDFLARE_ACCOUNT_ID if the token sees several accounts)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tayutau",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
